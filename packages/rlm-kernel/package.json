{
  "name": "@deepseek-ai/dsh-rlm-kernel",
  "description": "Persistent Python REPL kernel capability seam for the DeepSeek Harness",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/rlm/rlm-kernel"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.mjs",
    "lib/index.d.mts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.2"
  },
  "devDependencies": {
    "vitest": "^3.2.7",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2"
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  }
}
