{
  "name": "@deepseek-ai/dsh-rlm-harness-local",
  "description": "JSON-file provider for the harness-state capability seam, persisted under the DSH home",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/rlm/rlm-harness-local"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.mjs",
    "cordis.patch.yml",
    "lib/index.d.mts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-rlm-harness": "workspace:*",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "vitest": "^3.2.7",
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2"
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  }
}
